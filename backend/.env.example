NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ethara_team_task_manager
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ALLOW_PUBLIC_ADMIN_SIGNUP=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# FastAPI service settings. Use the same MONGO_URI and JWT_SECRET as Node.
ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible endpoint, such as a local model gateway.
# OPENAI_BASE_URL=http://localhost:1234/v1
